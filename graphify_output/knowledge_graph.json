      "id": "T1190",
      "type": "mitre_technique",
      "properties": {
        "name": "Exploit Public-Facing Application",
        "description": "The attacker exploits the SQL injection flaw in the MOVEit Transfer web interface, which is directly accessible from the internet, to gain initial access."
      }
    },
    {
      "id": "T1505.003",
      "type": "mitre_technique",
      "properties": {
        "name": "Server Software Component: Web Shell",
        "description": "Post-exploitation, attackers have been observed deploying the LemurLoot web shell on compromised MOVEit Transfer servers to maintain persistent access and exfiltrate data over HTTPS."
      }
    },
    {
      "id": "T1041",
      "type": "mitre_technique",
      "properties": {
        "name": "Exfiltration Over C2 Channel",
        "description": "Stolen database contents, including patient referral documents, are exfiltrated through the same HTTPS channel used for command and control, blending with legitimate MOVEit Transfer traffic."
      }
    },
