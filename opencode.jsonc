{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "options": {
        "setCacheKey": true
      }
    }
  },
  "mcp": {
    "db": {
      "type": "local",
      "command": ["npx", "-y", "@mokei/mcp-sqlite", "--db", "triagemate.db"],
      "description": "Query the TriageMate SQLite database"
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "description": "Safe file operations"
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{file:~/.config/opencode/github-token}"
      },
      "description": "GitHub access for Sploosh4/TriageMate"
    },
    "think": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "description": "Structured multi-step reasoning"
    }
  },
  "agent": {
    "explore": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "scout": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "general": {
      "model": "deepseek/deepseek-v4-flash"
    }
  }
}
