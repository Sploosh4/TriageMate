# TriageMate Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# Database URL (unset or empty = SQLite local file "triagemate.db")
# For PostgreSQL production:
# DATABASE_URL=postgresql://user:pass@localhost:5432/triagemate

# LLM Provider for Tier 2 (openai | anthropic | together)
TRIAGEMATE_LLM_PROVIDER=openai

# Your API key for the chosen provider
TRIAGEMATE_LLM_API_KEY=YOUR_API_KEY_HERE

# Model name (gpt-4o-mini recommended for cost)
TRIAGEMATE_LLM_MODEL=gpt-4o-mini

# Max tokens for LLM response
TRIAGEMATE_LLM_MAX_TOKENS=1024

# Timeout in seconds for LLM API calls
TRIAGEMATE_LLM_TIMEOUT=30

# CMDB Provider (stub | servicenow | itop)
TRIAGEMATE_CMDB_PROVIDER=stub

# API key for X-API-Key header auth on /api/* endpoints
# If left empty, all API requests pass (localhost-safe default)
TRIAGEMATE_API_KEY=

# Optional: override base URL for OpenAI-compatible providers (e.g., DeepSeek, local LLM)
# TRIAGEMATE_LLM_BASE_URL=https://api.deepseek.com/v1

# Optional backup provider
# TRIAGEMATE_LLM_BACKUP_PROVIDER=
# TRIAGEMATE_LLM_BACKUP_API_KEY=
# TRIAGEMATE_LLM_BACKUP_MODEL=

# NVD API 2.0 key (free, get at https://www.nist.gov/nvd/nvd-api-request)
# Without key: 5 req/s, unreliable (503 under load)
# With key: 50 req/s, stable
NVD_API_KEY=

# AlienVault OTX (LevelBlue) threat intel key (free, get at https://otx.alienvault.com)
TRIAGEMATE_OTX_API_KEY=

# JWT auth (optional — auth disabled when TRIAGEMATE_ADMIN_USER is unset)
# TRIAGEMATE_JWT_SECRET=change-me-to-a-random-secret
# TRIAGEMATE_ADMIN_USER=admin
# TRIAGEMATE_ADMIN_PASS=change-me

# Automatic retraining (disabled by default — requires explicit opt-in for Gate B)
# AUTOMATIC_RETRAINING_ENABLED=true

# Rate limiting
INGEST_RATE_PER_MIN=30
INGEST_BURST_SIZE=50
DEMO_RATE_PER_MIN=10
DEMO_BURST_SIZE=15
CLEAR_RATE_PER_MIN=2
CLEAR_BURST_SIZE=3

# OSV.dev is free — no API key needed
# See backend/integrations/osv.py

# ExploitDB CSV: download files_exploits.csv from
# https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv
# Place in backend/data/files_exploits.csv
