# TriageMate Environment Configuration
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# LLM Provider for Tier 2 (openai | anthropic | together)
TRIAGEMATE_LLM_PROVIDER=openai

# Your API key for the chosen provider
TRIAGEMATE_LLM_API_KEY=sk-your-key-here

# Model name (gpt-4o-mini recommended for cost)
TRIAGEMATE_LLM_MODEL=gpt-4o-mini

# Max tokens for LLM response
TRIAGEMATE_LLM_MAX_TOKENS=1024

# Timeout in seconds for LLM API calls
TRIAGEMATE_LLM_TIMEOUT=30

# Optional backup provider
# TRIAGEMATE_LLM_BACKUP_PROVIDER=
# TRIAGEMATE_LLM_BACKUP_API_KEY=
# TRIAGEMATE_LLM_BACKUP_MODEL=
